[Unit]
Description=Waldiez YouTube Search Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/waldiez/player
EnvironmentFile=/opt/waldiez/player/backend/search-service/.env
ExecStart=/usr/local/bin/bun run /opt/waldiez/player/backend/search-service/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/waldiez/player
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
